<section id="about" class="relative min-h-screen flex items-center overflow-hidden" style="background: var(--color-ink);">
  <!-- Abstract background texture -->
  <div class="absolute inset-0 opacity-30">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,rgba(255,255,255,0.15)_0%,transparent_50%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_80%,rgba(255,255,255,0.08)_0%,transparent_40%)]"></div>
  </div>

  <div class="container mx-auto px-4 py-24 md:py-32 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center" style="max-width: 1200px;">
    <div>
      <h1 class="text-h1 mb-2" style="color: var(--color-elementos);">aye vega</h1>
      <p class="text-big mb-6 md:mb-8" style="color: var(--color-elementos);">Graphic Designer</p>
      <p class="text-big max-w-xl leading-relaxed" style="color: rgba(255,255,255,0.9);">
        A passionate designer creating bold identities and digital experiences. I help brands tell their story through thoughtful design and purposeful solutions.
      </p>
    </div>

    <ul class="flex flex-col gap-4 text-big justify-center lg:justify-start lg:items-end" style="color: rgba(255,255,255,0.8); list-style: none; padding: 0; margin: 0;">
      <li>Branding and Identity</li>
      <li>Web Design</li>
      <li>UX/UI Design</li>
      <li>Motion</li>
    </ul>
  </div>
</section>
